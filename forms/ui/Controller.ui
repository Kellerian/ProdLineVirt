   <string notr="true">QToolButton {
    qproperty-alignment: AlignCenter;
	border: 1px solid #FF17365D;
    border-radius: 3px;
	background-color: #226091;
	padding: 3px;
	color: #FFFFFF;
	font: bold 12pt &quot;DejaVu Sans Mono&quot;;
}

QPushButton {
	border: 1px solid #FF17365D;
    border-radius: 3px;
	background-color: #226091;
	padding: 3px;
	color: #FFFFFF;
	font: bold 10pt &quot;DejaVu Sans Mono&quot;;
}

QPushButton:hover {
	color: #f0b321;
}

QPushButton:pressed,
QPushButton:checked {
	color: #f0b321;
	background-color: #19466a;
	border: 2px solid #f0b321;
}

QCheckBox {
	font: bold 10pt &quot;DejaVu Sans Mono&quot;;
}

QLineEdit {
	font: 10pt &quot;DejaVu Sans Mono&quot;;
}

QLabel {
	font: bold 10pt &quot;DejaVu Sans Mono&quot;;
}

QToolButton:hover {
	color: #f0b321;
}

QTableWidget {
	font: 8pt &quot;DejaVu Sans Mono&quot;;
}

QToolButton:pressed,
QToolButton:checked {
	color: #f0b321;
	background-color: #19466a;
	border: 2px solid #f0b321;
}

QSpinBox {
    qproperty-alignment: AlignCenter;
	border: 1px solid #FF17365D;
	color: #f0b321;
	background-color: #226091;
	border-radius: 3px;
	selection-background-color:#19466a;
	selection-color: #f0b321;
	font: bold 10pt &quot;DejaVu Sans Mono&quot;;
}

QSpinBox::up-button { subcontrol-origin: content;  subcontrol-position: right;  width:20px; height: 20px; }
QSpinBox::down-button {subcontrol-origin: content; subcontrol-position: left;  width:20px; height: 20px; }

QComboBox {
    border: 1px solid #17365D;
    border-radius: 3px;
	font: bold 10pt &quot;DejaVu Sans Mono&quot;;
	color: #f0b321;
    background-color: #226091;
	padding: 5px;
}

QComboBox:!editable:on {
    color: #f0b321;
	background-color: #19466a;
	border: 1px solid #f0b321;
}

QComboBox:on {
    padding-top: 3px;
    padding-left: 4px;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: right;
    width: 30px;
	background-color: #19466a;
    border-left-width: 1px;
    border-left-color: #17365D;
    border-left-style: solid;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
}

QComboBox::down-arrow:on {
    top: 1px;
    left: 1px;
}

QComboBox QAbstractItemView {
    selection-background-color: #f0b321;
	selection-color: #19466a;
	color: #f0b321;
	background-color: #19466a;
	border: 2px solid #f0b321;
}

QComboBox::item {
	color: #f0b321;
	background-color: #19466a;
}

QComboBox::item:hover {
	background-color: #226091;
}

QComboBox::item:selected {
	background-color: #f0b321;
	color: #19466a;
}

QComboBox QToolTip {
    font: bold 10pt &quot;DejaVu Sans Mono&quot;;
	color: #f0b321;
	background-color: #19466a;
	border: 2px solid #f0b321;
    border-radius: 3px;
}

QScrollBar {
	background: none;
	border: 1px;
	margin: 1;
	padding: 1;
	width: 15px;
}

QScrollBar:handle {
	border: 1px solid #FF17365D;
	background: #226091;
	border-radius: 3px;
	min-height: 45px;
	min-width: 15px;
}

QScrollBar:sub-line {
	background: none;
	border: none;
	height: 0px;
	padding: 0;
	width: 0px;
}

QScrollBar:add-line {
	background:  none;
	border: none;
	height: 0px;	
	padding: 0;
	width: 0px;
}

QWidget#Form {
	border: 1px solid #17365D;
	border-radius: 3px;
}</string>
